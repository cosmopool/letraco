<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: the icon at 288 dp on paper, the same first frame
     the Flutter splash starts from -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/paper" />
    <item android:width="288dp" android:height="288dp" android:gravity="center">
        <bitmap android:src="@drawable/ic_launcher_foreground" android:filter="true" />
    </item>
</layer-list>
